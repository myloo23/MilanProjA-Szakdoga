#######################################
# Container image versions
#######################################

# Gitea Git server
GITEA_VERSION=1.27.0

# Gitea Actions runner
RUNNER_VERSION=0.2.12

# Docker Registry
REGISTRY_VERSION=2

# Observability, added in Sprint 3. Pinned exactly, like every other tool in
# this project — a stack whose components float is a stack that can change its
# own dashboards overnight. Bump one at a time, in its own commit, so a panel
# that stops rendering is attributable.
PROMETHEUS_VERSION=v3.2.1
CADVISOR_VERSION=v0.52.1
NODE_EXPORTER_VERSION=v1.9.0
LOKI_VERSION=3.4.2
ALLOY_VERSION=v1.7.1
GRAFANA_VERSION=11.6.0


#######################################
# Host ports
#######################################

# Gitea Web UI
GITEA_HTTP_PORT=3000

# SSH clone port
GITEA_SSH_PORT=2222

# Docker Registry
REGISTRY_HTTP_PORT=5001

# Prometheus web UI. Published mainly to check targets — the dashboards are
# Grafana's job, but "is the app being scraped at all" is answered fastest here.
PROMETHEUS_HTTP_PORT=9090

# Loki's HTTP API. Published so `curl` can ask it questions without going
# through Grafana, which is how you tell "Loki has no logs" apart from
# "Grafana cannot reach Loki".
LOKI_HTTP_PORT=3100

# Grafana. 3001 and not 3000: Gitea already owns 3000 on this host, and two
# services claiming the same port is a demo that dies at `up -d`.
GRAFANA_HTTP_PORT=3001


#######################################
# Runner configuration
#######################################

# Generate this inside
# Gitea -> Site Administration -> Actions -> Runners
GITEA_RUNNER_REGISTRATION_TOKEN=replace-with-registration-token

# Display name inside Gitea
GITEA_RUNNER_NAME=projecta-local-runner


#######################################
# Grafana credentials
#######################################

# Set in platform/.env, which is gitignored. These are the only credentials in
# the stack and they guard a laptop dashboard, so the honest description is
# "not a secret worth protecting" — which is also why ansible-vault is still
# deliberately unbuilt (PLAN.md, Phase 4). Change them anyway: an admin/admin
# Grafana in a screenshot is the kind of detail a reviewer remembers.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-password